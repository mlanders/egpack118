{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "egpack118",
	"compatibility_date": "2026-11-08",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": "worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"triggers": { "crons": ["0 */6 * * *"] },
	"kv_namespaces": [
		{ "binding": "CALENDAR_CACHE", "id": "1de7a703907045d395ebb4d32a955cf4" }
	],
	// Previews only read the calendar snapshot; only the cron handler writes to KV and cron does not run on previews.
	"previews": {
		"kv_namespaces": [
			{ "binding": "CALENDAR_CACHE", "id": "1de7a703907045d395ebb4d32a955cf4" }
		]
	},
	"observability": { "enabled": true },
	"workers_dev": true,
	"preview_urls": true
}
